# Sellora API configuration. Copy to .env and fill in. Never commit real values.
# Generate secrets with: npm run keys:generate

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Cloudflare + load balancer = 2)
TRUST_PROXY_HOPS=0

API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
# Stores live at <handle>.<STOREFRONT_BASE_DOMAIN> (with a port in development; browsers send
# *.localhost to this machine). Production: your store domain, with a wildcard DNS record and
# certificate for *.<domain>, and STOREFRONT_URL_SCHEME=https.
STOREFRONT_BASE_DOMAIN=sellora.localhost:3100
STOREFRONT_URL_SCHEME=http
# Shared secret the sellora-storefront app sends with every call (the same value in its own
# environment). At least 32 characters, e.g. openssl rand -hex 32. Empty: stores stay closed.
STOREFRONT_API_KEY=
# Custom domains (ADR 0015). Businesses point a CNAME at this host, which must reach the
# storefront (e.g. domains.sellora.ai). Empty: custom domains are off.
STOREFRONT_DOMAIN_TARGET=
# IPv4/IPv6 addresses of the storefront, for apex domains (example.com cannot be a CNAME).
# Empty: only subdomains such as www.example.com can be connected.
STOREFRONT_DOMAIN_IPS=
# DNS servers asked when checking a domain's records (e.g. 1.1.1.1,8.8.8.8). Empty: the
# system's. For local testing with scripts/dns-stand-in.mjs: 127.0.0.1:5300
DNS_SERVERS=
CORS_ORIGINS=http://localhost:3000
# e.g. .sellora.ai in production so app.sellora.ai and api.sellora.ai share cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false

# MongoDB must be a replica set (transactions). Atlas or a self-hosted 3-node set.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=sellora
MONGODB_AUTO_INDEX=true

REDIS_URL=redis://127.0.0.1:6379/0
# Optional separate Redis for BullMQ queues (recommended in production)
REDIS_QUEUE_URL=
REDIS_KEY_PREFIX=sl:

JWT_ISSUER=sellora-api
JWT_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# JSON array of {"kid":"...","pem":"base64"} still accepted during key rotation
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_IDLE_DAYS=14
PLATFORM_ACCESS_TOKEN_TTL_SECONDS=300
PLATFORM_SESSION_TTL_HOURS=12

# kid:base64(32 bytes) pairs, comma separated. Add a new pair and switch the active kid to rotate.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KID=

# log = store mails in the mail_outbox collection (development only); smtp = deliver
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Sellora AI <no-reply@sellora.localhost>

# File storage for product photos and other uploads.
# local = this server's disk (uploads go through the API); s3 = any S3-compatible service
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2), where browsers upload straight to the bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Signs upload and download links. Required in production with the local driver.
# Generate with: openssl rand -hex 32
STORAGE_SIGNING_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public URL of the bucket or its CDN (no trailing slash). Leave empty to serve files
# through the API. The bucket needs a CORS rule that allows PUT from WEB_APP_URL. Only
# product photos (o/*/products/*) and online store pictures (o/*/store/*) may be publicly
# readable: customers' photos from chats (o/*/chat/*) are private and always served through
# the API to signed-in staff.
S3_PUBLIC_BASE_URL=
# Largest photo a merchant may upload, in MB, and how long an upload link stays valid.
FILE_MAX_IMAGE_MB=10
# Largest photo from a customer's chat that is saved, in MB (larger ones are not kept).
CHAT_MEDIA_MAX_MB=16
STORAGE_UPLOAD_TTL_SECONDS=600

# Backups (ADR 0020). Keys: kid:base64 of 32 random bytes (`npm run keys:generate` prints
# one), comma-separated; the active kid encrypts new backups. Required in production; keep a
# copy of these keys (and DATA_ENCRYPTION_KEYS) somewhere other than the backups.
BACKUP_ENCRYPTION_KEYS=
BACKUP_ENCRYPTION_ACTIVE_KID=
# Where a backup is written before upload (empty: the system's temporary folder).
BACKUP_TMP_DIR=
# Optional off-site copy: a second S3-compatible bucket at another provider and region.
BACKUP_OFFSITE_S3_ENDPOINT=
BACKUP_OFFSITE_S3_REGION=auto
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_ACCESS_KEY_ID=
BACKUP_OFFSITE_S3_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_S3_FORCE_PATH_STYLE=true
# Google Drive copies for merchants (ADR 0021): an OAuth client (Web application) in Google
# Cloud with the Drive API on and <API_PUBLIC_URL>/v1/backups/google/callback as redirect URI.
# Empty: the Drive card says Google Drive is not set up. The URLs below default to Google's;
# point them at scripts/google-stand-in.mjs (not Google) to try it locally.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GOOGLE_API_URL=https://www.googleapis.com

# Bearer token Prometheus uses to scrape /metrics (leave empty to disable the endpoint)
METRICS_TOKEN=

# Owner reports and alerts on Telegram (ADR 0022): a bot token from @BotFather. Empty: alerts
# go to the platform owners by email only. Chats are added in Admin › Telegram. Point
# TELEGRAM_API_URL at scripts/telegram-stand-in.mjs (not Telegram) to try it locally.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_URL=https://api.telegram.org

# Signs website chat visitor tokens (at least 32 characters). Required in production; changing it
# starts every visitor on a new chat.
WEBCHAT_TOKEN_SECRET=

# AI providers. The AI sales agent calls the provider of the model the super-admin picked for
# each tier (Super-admin › AI pricing); a provider without a key counts as unavailable.
AI_ANTHROPIC_API_KEY=
# Only when a gateway or proxy sits in front of the Anthropic API.
AI_ANTHROPIC_BASE_URL=
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=

# The platform's Meta app, for Messenger, Instagram and WhatsApp (developers.facebook.com).
# Webhook URL to register in the app: <API_PUBLIC_URL>/v1/webhooks/meta, with the verify token
# below. OAuth redirect URI to allow: <WEB_APP_URL>/app/connect/meta. Without an app id and
# secret, those channels show as unavailable and only the website chat works.
META_APP_ID=
META_APP_SECRET=
# At least 16 random characters.
META_WEBHOOK_VERIFY_TOKEN=
# Optional: a Facebook Login for Business configuration id.
META_LOGIN_CONFIG_ID=
# Optional: a WhatsApp Embedded Signup configuration id (shows the one-click WhatsApp button).
META_WHATSAPP_CONFIG_ID=
META_GRAPH_VERSION=v23.0
# Only when a proxy or a local stand-in sits in front of graph.facebook.com.
META_GRAPH_BASE_URL=

# Courier APIs (Steadfast, Pathao, RedX). Each business enters its own courier credentials in
# Settings › Couriers; they are stored encrypted with DATA_ENCRYPTION_KEYS. These addresses
# default to the couriers' production and sandbox APIs: set them only to point at a proxy or
# the local stand-in (scripts/courier-stand-in.mjs).
COURIER_STEADFAST_BASE_URL=
COURIER_PATHAO_BASE_URL=
COURIER_PATHAO_SANDBOX_URL=
COURIER_REDX_BASE_URL=
COURIER_REDX_SANDBOX_URL=
# Public tracking pages; {tracking}, {consignment} and {phone} are filled in. Leave unset for
# the defaults, or set to an empty value to hide the link.
# COURIER_STEADFAST_TRACKING_URL=https://steadfast.com.bd/t/{tracking}
# COURIER_PATHAO_TRACKING_URL=https://merchant.pathao.com/tracking?consignment_id={consignment}&phone={phone}
# COURIER_REDX_TRACKING_URL=https://redx.com.bd/track-parcel/?trackingId={tracking}
COURIER_HTTP_TIMEOUT_MS=20000

# SMS (ADR 0017). Businesses enter their own SMS provider credentials in Settings › SMS, and
# the super-admin sets up Sellora SMS (the platform's provider, prices) in Admin › SMS; both
# are stored encrypted with DATA_ENCRYPTION_KEYS. These addresses default to the providers'
# published APIs: set them only to point at a proxy or the local stand-in
# (scripts/sms-stand-in.mjs).
SMS_BULKSMSBD_BASE_URL=
SMS_ALPHA_BASE_URL=
SMS_SSL_WIRELESS_BASE_URL=
SMS_TWILIO_BASE_URL=
SMS_HTTP_TIMEOUT_MS=15000
# Messages one business may send a day (the super-admin can set a different limit per business).
SMS_DAILY_LIMIT=1000

# Fraud check: keys the phone-number hashes of the shared delivery network (at least 32
# characters, e.g. openssl rand -hex 32). The network also needs the super-admin switch
# (off by default) and each business's own opt-in. Without this value it stays off.
FRAUD_NETWORK_SECRET=

# Insert starter plans, AI model prices and the AI credit price list on boot when they are
# missing. Existing rows are never changed; the super-admin edits them in the admin panel.
# Payment gateway credentials (SSLCommerz, bKash, Stripe) are entered in the admin panel and
# stored encrypted with DATA_ENCRYPTION_KEYS, so they do not live in this file.
BILLING_SEED_DEFAULTS=true
# Days in platform reports (AI revenue and profit per day) are cut in this time zone.
PLATFORM_REPORT_TIMEZONE=Asia/Dhaka

RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_IP_MULTIPLIER=1
