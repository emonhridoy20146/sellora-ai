# Copy to .env.local for development. Only NEXT_PUBLIC_* values reach the browser.

# Where the Next.js server reaches the Sellora API. The browser never calls this directly:
# /v1/* on this site is proxied there, so auth cookies stay first-party.
API_INTERNAL_URL=http://127.0.0.1:4000

# Public URL of this web app (used in metadata and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand shown in the UI. Lets a white-label deployment rename the product without code changes.
NEXT_PUBLIC_BRAND_NAME=Sellora AI

# Support contact shown on public pages when the API's platform status is unavailable.
NEXT_PUBLIC_SUPPORT_EMAIL=support@sellora.ai
