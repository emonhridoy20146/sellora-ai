{
  "name": "sellora-api",
  "version": "0.1.0",
  "private": true,
  "description": "Sellora AI platform API (NestJS) and background workers",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --copy-files",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "openapi:export": "node --env-file-if-exists=.env --import @swc-node/register/esm-register scripts/export-openapi.ts",
    "keys:generate": "node scripts/generate-keys.mjs",
    "platform:bootstrap": "node --env-file-if-exists=.env --import @swc-node/register/esm-register scripts/platform-bootstrap.ts",
    "db:indexes": "node --env-file-if-exists=.env --import @swc-node/register/esm-register scripts/sync-indexes.ts",
    "dev:seed": "node --env-file-if-exists=.env --import @swc-node/register/esm-register scripts/dev-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/websockets": "12.3.2",
    "@simplewebauthn/server": "14.0.3",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "bullmq": "6.5.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "libphonenumber-js": "1.13.15",
    "mongoose": "9.11.4",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "otplib": "13.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "rate-limiter-flexible": "11.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
