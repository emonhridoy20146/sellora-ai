# The Sellora API, as this server reaches it (not the public address).
API_INTERNAL_URL=http://127.0.0.1:4000
# Must equal STOREFRONT_API_KEY in the API's .env (at least 32 characters). Server-side only:
# the browser never sees it.
STOREFRONT_API_KEY=
# Proxies in front of this app that set X-Forwarded-For (Caddy in production: 1). The shopper's
# address is read that many entries from the right, so it cannot be spoofed past the proxy.
TRUST_PROXY_HOPS=1
